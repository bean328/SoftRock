{
  "name": "SoftRock",
  "style": "flat modern",
  "colors": {
    "background":   { "light": "#F5F6F8", "dark": "#121418" },
    "surface":      { "light": "#FFFFFF", "dark": "#1B1E24" },
    "surfaceAlt":   { "light": "#ECEEF2", "dark": "#242830" },
    "border":       { "light": "#DDE1E7", "dark": "#2F343D" },
    "text":         { "light": "#1B1F27", "dark": "#E8EBF0" },
    "textMuted":    { "light": "#5B6474", "dark": "#9AA3B2" },
    "accent":       { "light": "#5B52D6", "dark": "#9D96FF" },
    "accentText":   { "light": "#FFFFFF", "dark": "#14121F" },
    "good":         { "light": "#1F8A57", "dark": "#4CC38A" },
    "warn":         { "light": "#9A5C00", "dark": "#E5A443" },
    "bad":          { "light": "#C8372D", "dark": "#F0716A" }
  },
  "terminal": {
    "dark": {
      "background": "#121418",
      "foreground": "#E8EBF0",
      "regular": ["#1B1E24", "#F0716A", "#4CC38A", "#E5A443", "#7AA2F7", "#9D96FF", "#5CC8D7", "#C9CED8"],
      "bright":  ["#4A515E", "#FF8F88", "#6ED9A3", "#F2BD6B", "#9ABBFF", "#B9B3FF", "#82DCE8", "#FFFFFF"]
    }
  },
  "radius":  { "small": 8, "medium": 12, "large": 20, "pill": 999 },
  "spacing": { "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 24, "xxl": 32 },
  "font": {
    "display": "Lexend",
    "ui": "Figtree",
    "mono": "JetBrains Mono",
    "size": { "small": 12, "body": 14, "title": 18, "display": 28 }
  },
  "motion": { "fast": 120, "normal": 200, "slow": 320 },
  "bar": { "height": 36, "gap": 8 },
  "tiers": {
    "lite":     { "blur": false, "blurSize": 0, "blurPasses": 0, "shadow": false, "shadowRange": 0,  "animationSpeed": 2, "gapsIn": 4, "gapsOut": 8 },
    "standard": { "blur": true,  "blurSize": 6, "blurPasses": 1, "shadow": true,  "shadowRange": 12, "animationSpeed": 4, "gapsIn": 5, "gapsOut": 10 },
    "ultra":    { "blur": true,  "blurSize": 8, "blurPasses": 3, "shadow": true,  "shadowRange": 22, "animationSpeed": 5, "gapsIn": 6, "gapsOut": 12 }
  }
}
