#!/bin/sh
# Identify the system as SoftRock while keeping Debian's ID for compatibility.
set -e

cat > /etc/os-release <<OSR
PRETTY_NAME="SoftRock (Phase 0, based on Debian 13 trixie)"
NAME="SoftRock"
VERSION_ID="0.1"
VERSION="0.1 (Foundation)"
VERSION_CODENAME=trixie
ID=softrock
ID_LIKE=debian
HOME_URL="https://github.com/bean328/SoftRock"
BUG_REPORT_URL="https://github.com/bean328/SoftRock/issues"
OSR
