live-boot
live-config
live-config-systemd
systemd-sysv
systemd-oomd
dbus-broker
sudo
locales
console-setup
keyboard-configuration
user-setup
intel-microcode
amd64-microcode

# Graphics
mesa-vulkan-drivers
libgl1-mesa-dri
libegl1
mesa-va-drivers
intel-media-va-driver

# Session
hyprland
xwayland
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
greetd
polkitd
lxpolkit
upower
qt6-wayland
fuzzel
mako-notifier
grim
slurp
wl-clipboard
brightnessctl

# Audio, network, power
