#!/bin/sh
# SoftRock live image configuration for Debian live build.
# Run through "lb config" from the iso/ directory.
set -e

lb config noauto \
	--distribution trixie \
	--architectures amd64 \
	--archive-areas "main contrib non-free non-free-firmware" \
	--binary-images iso-hybrid \
	--debian-installer none \
	--apt-recommends false \
	--firmware-chroot true \
	--linux-flavours amd64 \
	--memtest none \
	--image-name softrock \
	--iso-application "SoftRock" \
	--iso-publisher "SoftRock" \
	--iso-volume "SoftRock" \
	--bootappend-live "boot=live components quiet username=softrock hostname=softrock zswap.enabled=1 zswap.compressor=zstd" \
	"${@}"
